import { OnlineGlobal } from "online.slint";
import { Theme } from "theme.slint";
import {
    Button,
    CheckBox,
} from "std-widgets.slint";

component LangButton inherits Rectangle {
    in property <string> lang-code;
    in property <string> current-lang;
    in property <string> text;
    callback clicked(string);
    border-radius: 4px;
    border-width: 1px;
    border-color: lang-code == current-lang ? Theme.accent : Theme.border;
    background: lang-code == current-lang ? Theme.accent : Theme.hover;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 4px;
        padding-bottom: 4px;
        alignment: center;
        Text {
            text: root.text;
            color: lang-code == current-lang ? Theme.surface : Theme.text;
            font-size: 13px;
        }
    }

    TouchArea {
        clicked => { root.clicked(lang-code); }
    }
}

export component SettingsPanel inherits Rectangle {
    in-out property <string> song_dir;
    in-out property <string> lang;
    in-out property <bool> follow_system_theme;
    callback set_lang(string);
    callback set_follow_system_theme(bool);
    in property <string> version;
    callback open-upstream();
    callback select_song_dir();
    background: Theme.surface;

    Flickable {
        width: 100%;
        height: 100%;
        content-height: layout.preferred-height;
        interactive: true;

        layout := VerticalLayout {
            width: 100%;
            padding: 24px;
            spacing: 20px;

            // --- Playback Section ---
            Rectangle {
                background: Theme.panel;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    Text {
                        text: @tr("Playback");
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.text-tertiary;
                        letter-spacing: 0.3px;
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.divider;
                    }

                    // Music directory
                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: @tr("Music directory");
                            font-size: 13px;
                            color: Theme.text-secondary;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.hover;
                                horizontal-stretch: 1;
                                clip: true;
                                Text {
                                    x: 12px;
                                    width: parent.width - 24px;
                                    height: 100%;
                                    text: root.song_dir;
                                    color: Theme.text-secondary;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            Button {
                                text: @tr("Browse...");
                                clicked => {
                                    root.select_song_dir();
                                }
                            }
                        }
                    }

                }
            }

            if OnlineGlobal.available: VerticalLayout {
                spacing: 8px;
                Text { text: @tr("LX music source"); color: Theme.text; font-weight: 600; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Button {
                        text: OnlineGlobal.importing ? @tr("Initializing…") : @tr("Import JS source…");
                        enabled: !OnlineGlobal.importing;
                        clicked => { OnlineGlobal.import-script(); }
                    }
                    if OnlineGlobal.installed: CheckBox {
                        text: @tr("Enabled");
                        checked <=> OnlineGlobal.enabled;
                        enabled: !OnlineGlobal.importing;
                        toggled => { OnlineGlobal.enable-script(self.checked); }
                    }
                }
                if OnlineGlobal.installed: Text {
                    text: OnlineGlobal.script-summary;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
            }

            // --- Appearance Section ---
            Rectangle {
                background: Theme.panel;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    Text {
                        text: @tr("Appearance");
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.text-tertiary;
                        letter-spacing: 0.3px;
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.divider;
                    }

                    // Follow system theme
                    CheckBox {
                        text: @tr("Follow system theme");
                        checked <=> root.follow_system_theme;
                        toggled => {
                            root.set_follow_system_theme(self.checked);
                        }
                    }

                    // Language
                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: @tr("Language");
                            font-size: 13px;
                            color: Theme.text-secondary;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            for lc[i] in ["", "zh_CN"]: LangButton {
                                lang-code: lc;
                                current-lang: root.lang;
                                text: lc == "" ? "English" : "中文";
                                clicked(code) => { root.lang = code; root.set_lang(code); }
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 12px;
                Text {
                    text: @tr("SealMusic {} · GPL-3.0", root.version);
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
                Button {
                    text: @tr("Upstream project");
                    clicked => { root.open-upstream(); }
                }
            }
        }
    }
}
