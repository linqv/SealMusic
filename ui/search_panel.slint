import { OnlineGlobal } from "online.slint";
import { OnlineIssue } from "types.slint";
import { CollectionsGlobal, TrackActions } from "collections.slint";
import { Theme } from "theme.slint";
import { Button, LineEdit, ListView } from "std-widgets.slint";
import { LocalSongMenu, SongDetails } from "song_list.slint";
import { SongInfo } from "types.slint";

component SearchResultRow inherits Rectangle {
    in property <SongInfo> info;
    in property <int> number;
    in property <bool> playing;
    in property <bool> play-on-click;
    private property <color> text-color: root.playing ? Theme.accent : Theme.text;
    private property <bool> show-actions: row-input.has-hover || CollectionsGlobal.picker-anchor.track == root.info.id;
    callback play();

    height: 48px;
    background: root.playing ? Theme.hover : root.show-actions ? Theme.song-hover : Theme.surface;
    border-width: keyboard.has-focus ? 1px : 0px;
    border-color: Theme.accent;
    forward-focus: keyboard;

    row-input := TouchArea {
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: root.info.song-name + " · " + root.info.singer;
        accessible-action-default => { root.play(); }
        clicked => {
            if root.play-on-click { root.play(); }
        }
        double-clicked => {
            if !root.play-on-click { root.play(); }
        }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 24px;
            spacing: 12px;

            Text {
                width: 36px;
                text: "\{root.number}";
                color: Theme.text-tertiary;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
                HorizontalLayout {
                    x: 0px;
                    width: 100%;
                    height: 100%;
                    spacing: 16px;
                    Text {
                        width: (parent.width - 16px) * 0.58;
                        text: root.info.song-name;
                        color: root.text-color;
                        font-weight: root.playing ? 600 : 400;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: root.info.singer;
                        color: root.text-color;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                Tooltip {
                    SongDetails {
                        info: root.info;
                        artist: root.info.singer;
                    }
                }
            }

            Rectangle {
                width: 64px;
                TrackActions {
                    width: 100%;
                    height: 28px;
                    visible: root.show-actions;
                    track: root.info.id;
                }
            }

            Text {
                width: 56px;
                text: root.info.duration;
                color: root.text-color;
                vertical-alignment: center;
                horizontal-alignment: right;
                overflow: elide;
            }
        }
    }

    keyboard := FocusScope {
        width: 0px;
        enabled: root.play-on-click;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.play();
                return accept;
            }
            return reject;
        }
    }

    if root.info.is-local && OnlineGlobal.local-playback: LocalSongMenu {
        track: root.info.id;
    }
}

export component SearchPanel inherits Rectangle {
    in-out property <string> search-query;
    in property <[SongInfo]> search-results;
    in property <[SongInfo]> library-songs;
    in property <SongInfo> current-song;
    private property <bool> catalog: OnlineGlobal.catalog-page > 0
        && OnlineGlobal.catalog-query == root.search-query
        && OnlineGlobal.catalog-source == OnlineGlobal.search-source;
    private property <bool> can-search-online: OnlineGlobal.available
        && !OnlineGlobal.is-blank(root.search-query) && !(root.catalog && OnlineGlobal.catalog-busy);
    callback search(string);
    callback play-song(SongInfo);

    background: Theme.surface;

    function search-online() {
        if root.can-search-online {
            OnlineGlobal.search-catalog(OnlineGlobal.search-source, root.search-query, 1);
        }
    }

    // Intercept global shortcuts when the search input has focus,
    // so they don't bubble up to the parent FocusScope and trigger actions.
    // Space/arrows are naturally consumed by LineEdit; only F1-F4 need blocking.
    // Must use key-released (not KeyBinding) to conditionally intercept only
    // when search-input has focus, so shortcuts reach the parent otherwise.
    key-handler := FocusScope {
        width: 100%;
        height: 100%;
        forward-focus: search-input;

        key-released(event) => {
            if !search-input.has-focus {
                return reject;
            }
            if event.text == Key.F1
                || event.text == Key.F2
                || event.text == Key.F3
                || event.text == Key.F4 {
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            width: 100%;
            height: 100%;
            spacing: 0px;

            // Search bar
            Rectangle {
                height: 40px;
                width: 100%;
                background: Theme.surface;

                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    spacing: 8px;
                    padding-left: 12px;
                    padding-right: 48px;
                    padding-top: 8px;
                    padding-bottom: 8px;

                    search-input := LineEdit {
                        horizontal-stretch: 1;
                        height: 100%;
                        placeholder-text: @tr("Search songs…");
                        text <=> root.search-query;
                        font-size: 13px;

                        edited => {
                            if OnlineGlobal.available { OnlineGlobal.cancel-catalog(); }
                            root.search(self.text);
                        }
                        accepted => { root.search-online(); }
                    }
                    if OnlineGlobal.available: HorizontalLayout {
                        spacing: 6px;
                        Button {
                            text: @tr("Search online");
                            enabled: root.can-search-online;
                            clicked => { root.search-online(); }
                        }
                        if root.catalog: Button {
                            text: OnlineGlobal.catalog-busy ? @tr("Cancel") : @tr("Local library");
                            clicked => {
                                OnlineGlobal.cancel-catalog();
                            }
                        }
                    }
                }
            }

            if root.catalog: VerticalLayout {
                vertical-stretch: 1;
                spacing: 6px;
                padding: 8px;
                if OnlineGlobal.catalog-busy || OnlineGlobal.catalog-failed || OnlineGlobal.catalog-rows.length == 0: Text {
                    text: OnlineGlobal.catalog-busy ? @tr("Searching…")
                        : OnlineGlobal.catalog-failed ? @tr("Search failed.") : @tr("No results found");
                    color: Theme.text-secondary;
                }
                if OnlineGlobal.catalog-partial-failure: Text {
                    text: @tr("Some platforms could not be searched.");
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                if OnlineGlobal.catalog-failed || OnlineGlobal.catalog-partial-failure: Button {
                    text: @tr("Retry");
                    clicked => {
                        OnlineGlobal.search-catalog(OnlineGlobal.catalog-source, root.search-query, OnlineGlobal.catalog-page);
                    }
                }
                if !OnlineGlobal.enabled && OnlineGlobal.catalog-rows.length > 0: Text {
                    width: 100%;
                    text: OnlineGlobal.issue-text(OnlineIssue.NoScript, "");
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                ListView {
                    vertical-stretch: 1;
                    for song[index] in OnlineGlobal.catalog-rows: SearchResultRow {
                        info: song;
                        number: index + 1;
                        playing: song.id == root.current-song.id;
                        play-on-click: true;
                        play => { OnlineGlobal.play-catalog(song.id); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: @tr("Previous page");
                        enabled: !OnlineGlobal.catalog-busy && OnlineGlobal.catalog-page > 1;
                        clicked => {
                            OnlineGlobal.search-catalog(OnlineGlobal.catalog-source, root.search-query, OnlineGlobal.catalog-page - 1);
                        }
                    }
                    Text {
                        text: @tr("Page {}", OnlineGlobal.catalog-page);
                        color: Theme.text;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: @tr("Next page");
                        enabled: !OnlineGlobal.catalog-busy && OnlineGlobal.catalog-next;
                        clicked => {
                            OnlineGlobal.search-catalog(OnlineGlobal.catalog-source, root.search-query, OnlineGlobal.catalog-page + 1);
                        }
                    }
                }
            }

            // Results count label
            if !root.catalog && root.search-query != "": Rectangle {
                height: 26px;
                width: 100%;
                background: Theme.surface;

                Text {
                    x: 12px;
                    y: (parent.height - self.height) / 2;
                    text: root.search-results.length == 0
                        ? @tr("No results found")
                        : @tr("{} result(s) found", root.search-results.length);
                    color: Theme.text-tertiary;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }

            // Results list
            if !root.catalog && (root.search-query != "" || root.library-songs.length > 0): ListView {
                horizontal-stretch: 1;
                vertical-stretch: 1;

                for item[index] in root.search-query == "" ? root.library-songs : root.search-results: SearchResultRow {
                    info: item;
                    number: index + 1;
                    playing: item.id == root.current-song.id;
                    play => { root.play-song(item); }
                }
            }

            if root.search-query == "" && root.library-songs.length == 0: Text {
                text: @tr("No local songs found.");
                color: Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
                vertical-stretch: 1;
            }
        }
    }
}
