import { OnlineGlobal } from "online.slint";
import { OnlineIssue } from "types.slint";
import { TrackActions } from "collections.slint";
import { Theme } from "theme.slint";
import { Button, LineEdit } from "std-widgets.slint";
import { ListView } from "std-widgets.slint";
import { SongItem } from "song_list.slint";
import { SongInfo } from "types.slint";

export component SearchPanel inherits Rectangle {
    in-out property <string> search-query;
    in property <[SongInfo]> search-results;
    in property <[SongInfo]> library-songs;
    in property <SongInfo> current-song;
    private property <bool> is-link: OnlineGlobal.available && OnlineGlobal.is-link(root.search-query);
    private property <bool> catalog: OnlineGlobal.catalog-page > 0
        && OnlineGlobal.catalog-query == root.search-query
        && OnlineGlobal.catalog-source == OnlineGlobal.search-source;
    private property <bool> can-search-online: OnlineGlobal.available && !root.is-link
        && !OnlineGlobal.is-blank(root.search-query) && !(root.catalog && OnlineGlobal.catalog-busy);
    callback search(string);
    callback play-song(SongInfo);

    background: Theme.surface;

    function search-online() {
        if root.can-search-online {
            OnlineGlobal.search-catalog(OnlineGlobal.search-source, root.search-query, 1);
        }
    }

    // Intercept global shortcuts when the search input has focus,
    // so they don't bubble up to the parent FocusScope and trigger actions.
    // Space/arrows are naturally consumed by LineEdit; only F1-F4 need blocking.
    // Must use key-released (not KeyBinding) to conditionally intercept only
    // when search-input has focus, so shortcuts reach the parent otherwise.
    key-handler := FocusScope {
        width: 100%;
        height: 100%;
        forward-focus: search-input;

        key-released(event) => {
            if !search-input.has-focus {
                return reject;
            }
            if event.text == Key.F1
                || event.text == Key.F2
                || event.text == Key.F3
                || event.text == Key.F4 {
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            width: 100%;
            height: 100%;
            spacing: 0px;

            // Search bar
            Rectangle {
                height: 40px;
                width: 100%;
                background: Theme.surface;

                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    spacing: 8px;
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;

                    search-input := LineEdit {
                        horizontal-stretch: 1;
                        height: 100%;
                        placeholder-text: OnlineGlobal.available ? @tr("Search songs or paste an LX track link") : @tr("Search songs or artists...");
                        text <=> root.search-query;
                        font-size: 13px;

                        edited => {
                            if OnlineGlobal.available { OnlineGlobal.cancel-catalog(); }
                            root.search(self.text);
                        }
                        accepted => { root.search-online(); }
                    }
                    if OnlineGlobal.available && !root.is-link: HorizontalLayout {
                        spacing: 6px;
                        Button {
                            text: @tr("Search online");
                            enabled: root.can-search-online;
                            clicked => { root.search-online(); }
                        }
                        if root.catalog: Button {
                            text: OnlineGlobal.catalog-busy ? @tr("Cancel") : @tr("Local library");
                            clicked => {
                                OnlineGlobal.cancel-catalog();
                            }
                        }
                    }
                }
            }

            if root.catalog: VerticalLayout {
                vertical-stretch: 1;
                spacing: 6px;
                padding: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: @tr("Previous page");
                        enabled: !OnlineGlobal.catalog-busy && OnlineGlobal.catalog-page > 1;
                        clicked => {
                            OnlineGlobal.search-catalog(OnlineGlobal.catalog-source, root.search-query, OnlineGlobal.catalog-page - 1);
                        }
                    }
                    Text {
                        text: @tr("{} · Page {}", OnlineGlobal.source-name(OnlineGlobal.catalog-source), OnlineGlobal.catalog-page);
                        color: Theme.text;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: @tr("Next page");
                        enabled: !OnlineGlobal.catalog-busy && OnlineGlobal.catalog-next;
                        clicked => {
                            OnlineGlobal.search-catalog(OnlineGlobal.catalog-source, root.search-query, OnlineGlobal.catalog-page + 1);
                        }
                    }
                }
                if OnlineGlobal.catalog-busy || OnlineGlobal.catalog-failed || OnlineGlobal.catalog-rows.length == 0: Text {
                    text: OnlineGlobal.catalog-busy ? @tr("Searching {}…", OnlineGlobal.source-name(OnlineGlobal.catalog-source))
                        : OnlineGlobal.catalog-failed ? @tr("{} search failed.", OnlineGlobal.source-name(OnlineGlobal.catalog-source)) : @tr("No results found");
                    color: Theme.text-secondary;
                }
                if OnlineGlobal.catalog-partial-failure: Text {
                    text: @tr("Some platforms could not be searched.");
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                if OnlineGlobal.catalog-failed || OnlineGlobal.catalog-partial-failure: Button {
                    text: @tr("Retry");
                    clicked => {
                        OnlineGlobal.search-catalog(OnlineGlobal.catalog-source, root.search-query, OnlineGlobal.catalog-page);
                    }
                }
                if !OnlineGlobal.enabled && OnlineGlobal.catalog-rows.length > 0: Text {
                    width: 100%;
                    text: OnlineGlobal.issue-text(OnlineIssue.NoScript, "");
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                ListView {
                    vertical-stretch: 1;
                    for row in OnlineGlobal.catalog-rows: HorizontalLayout {
                        padding-top: 2px;
                        padding-bottom: 2px;
                        Button {
                            horizontal-stretch: 1;
                            primary: row.song.id == root.current-song.id;
                            text: row.song.song-name + " · " + row.song.singer
                                + (OnlineGlobal.catalog-source == "all" ? " · " + OnlineGlobal.source-name(row.source) : "");
                            clicked => { OnlineGlobal.play-catalog(row.song.id); }
                        }
                        TrackActions {
                            width: 64px;
                            track: row.song.id;
                        }
                    }
                }
            }

            if root.is-link && OnlineGlobal.preview-query == root.search-query: VerticalLayout {
                padding: 12px;
                spacing: 8px;
                Text {
                    text: OnlineGlobal.preview-issue == OnlineIssue.None ? OnlineGlobal.preview-detail
                        : OnlineGlobal.issue-text(OnlineGlobal.preview-issue, OnlineGlobal.preview-detail);
                    color: Theme.text;
                    wrap: word-wrap;
                }
                if OnlineGlobal.preview-issue == OnlineIssue.None: HorizontalLayout {
                    alignment: start;
                    Button {
                        primary: true;
                        text: @tr("Play");
                        clicked => { OnlineGlobal.play-link(root.search-query); }
                    }
                    TrackActions {
                        width: 64px;
                        track: OnlineGlobal.preview-track;
                    }
                }
            }
            if root.is-link: Rectangle { vertical-stretch: 1; }

            // Results count label
            if !root.catalog && !root.is-link && root.search-query != "": Rectangle {
                height: 26px;
                width: 100%;
                background: Theme.surface;

                Text {
                    x: 12px;
                    y: (parent.height - self.height) / 2;
                    text: root.search-results.length == 0
                        ? @tr("No results found")
                        : @tr("{} result(s) found", root.search-results.length);
                    color: Theme.text-tertiary;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }

            // Results list
            if !root.catalog && !root.is-link && (root.search-query != "" || root.library-songs.length > 0): ListView {
                horizontal-stretch: 1;
                vertical-stretch: 1;

                for item in root.search-query == "" ? root.library-songs : root.search-results: SongItem {
                    info: item;
                    playing: item.id == root.current-song.id;
                    double_clicked => {
                        root.play-song(item);
                    }
                }
            }

            if root.search-query == "" && root.library-songs.length == 0: Text {
                text: @tr("No local songs found.");
                color: Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
                vertical-stretch: 1;
            }
        }
    }
}
