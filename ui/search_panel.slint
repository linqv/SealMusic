import { OnlineGlobal } from "online.slint";
import { OnlineIssue } from "types.slint";
import { Theme } from "theme.slint";
import { Button, LineEdit } from "std-widgets.slint";
import { ListView } from "std-widgets.slint";
import { SongItem } from "song_list.slint";
import { SongInfo } from "types.slint";
import { IconDisplay, IconSet } from "@lucide";

export component SearchPanel inherits Rectangle {
    in-out property <string> search-query;
    in property <[SongInfo]> search-results;
    in property <SongInfo> current-song;
    private property <bool> is-link: OnlineGlobal.available && OnlineGlobal.is-link(root.search-query);
    private property <bool> catalog: OnlineGlobal.catalog-page > 0 && OnlineGlobal.catalog-query == root.search-query;
    private property <string> selected-id;
    callback search(string);
    callback play-song(SongInfo);

    background: Theme.surface;

    // Intercept global shortcuts when the search input has focus,
    // so they don't bubble up to the parent FocusScope and trigger actions.
    // Space/arrows are naturally consumed by LineEdit; only F1-F4 need blocking.
    // Must use key-released (not KeyBinding) to conditionally intercept only
    // when search-input has focus, so shortcuts reach the parent otherwise.
    key-handler := FocusScope {
        width: 100%;
        height: 100%;
        forward-focus: search-input;

        key-released(event) => {
            if !search-input.has-focus {
                return reject;
            }
            if event.text == Key.F1
                || event.text == Key.F2
                || event.text == Key.F3
                || event.text == Key.F4 {
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            width: 100%;
            height: 100%;
            spacing: 0px;

            // Search bar
        Rectangle {
                height: 40px;
                width: 100%;
                background: Theme.surface;

                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    spacing: 8px;
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;

                    search-input := LineEdit {
                        horizontal-stretch: 1;
                        height: 100%;
                        placeholder-text: OnlineGlobal.available ? @tr("Search songs or paste an LX track link") : @tr("Search songs or artists...");
                        text <=> root.search-query;
                        font-size: 13px;

                        edited => {
                            root.selected-id = "";
                            if OnlineGlobal.available { OnlineGlobal.cancel-catalog(); }
                            root.search(self.text);
                        }
                    }
                    if OnlineGlobal.available && !root.is-link: HorizontalLayout {
                        spacing: 6px;
                        for s in ["kw", "kg", "tx", "wy", "mg"]: Button {
                            text: OnlineGlobal.source-name(s);
                            primary: root.catalog && OnlineGlobal.catalog-source == s;
                            enabled: !OnlineGlobal.is-blank(root.search-query);
                            clicked => {
                                root.selected-id = "";
                                OnlineGlobal.search-catalog(s, root.search-query, 1);
                            }
                        }
                        if root.catalog: Button {
                            text: OnlineGlobal.catalog-busy ? @tr("Cancel") : @tr("Local library");
                            clicked => {
                                root.selected-id = "";
                                OnlineGlobal.cancel-catalog();
                            }
                        }
                    }
                }
            }

            if root.catalog: VerticalLayout {
                vertical-stretch: 1;
                spacing: 6px;
                padding: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: @tr("Previous page");
                        enabled: !OnlineGlobal.catalog-busy && OnlineGlobal.catalog-page > 1;
                        clicked => {
                            root.selected-id = "";
                            OnlineGlobal.search-catalog(OnlineGlobal.catalog-source, root.search-query, OnlineGlobal.catalog-page - 1);
                        }
                    }
                    Text {
                        text: @tr("{} · Page {}", OnlineGlobal.source-name(OnlineGlobal.catalog-source), OnlineGlobal.catalog-page);
                        color: Theme.text;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: @tr("Next page");
                        enabled: !OnlineGlobal.catalog-busy && OnlineGlobal.catalog-next;
                        clicked => {
                            root.selected-id = "";
                            OnlineGlobal.search-catalog(OnlineGlobal.catalog-source, root.search-query, OnlineGlobal.catalog-page + 1);
                        }
                    }
                }
                if OnlineGlobal.catalog-busy || OnlineGlobal.catalog-failed || OnlineGlobal.catalog-rows.length == 0: Text {
                    text: OnlineGlobal.catalog-busy ? @tr("Searching {}…", OnlineGlobal.source-name(OnlineGlobal.catalog-source))
                        : OnlineGlobal.catalog-failed ? @tr("{} search failed.", OnlineGlobal.source-name(OnlineGlobal.catalog-source)) : @tr("No results found");
                    color: Theme.text-secondary;
                }
                if OnlineGlobal.catalog-failed: Button {
                    text: @tr("Retry");
                    clicked => {
                        OnlineGlobal.search-catalog(OnlineGlobal.catalog-source, root.search-query, OnlineGlobal.catalog-page);
                    }
                }
                ListView {
                    vertical-stretch: 1;
                    for row in OnlineGlobal.catalog-rows: VerticalLayout {
                        spacing: 4px;
                        padding-top: 2px;
                        padding-bottom: 2px;
                        Button {
                            text: row.song.song-name + " · " + row.song.singer;
                            clicked => {
                                root.selected-id = root.selected-id == row.song.id ? "" : row.song.id;
                            }
                        }
                        if root.selected-id == row.song.id && row.qualities.length > 0: HorizontalLayout {
                            alignment: start;
                            spacing: 6px;
                            for q in row.qualities: Button {
                                text: @tr("Play at {}", q);
                                clicked => { OnlineGlobal.play-catalog(row.song.id, q); }
                            }
                        }
                        if root.selected-id == row.song.id && row.qualities.length == 0: Text {
                            width: 100%;
                            text: OnlineGlobal.issue-text(OnlineGlobal.enabled ? OnlineIssue.NoQuality : OnlineIssue.NoScript, "");
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            if root.is-link && OnlineGlobal.preview-query == root.search-query: VerticalLayout {
                padding: 12px;
                spacing: 8px;
                Text {
                    text: OnlineGlobal.preview-issue == OnlineIssue.None ? OnlineGlobal.preview-detail
                        : OnlineGlobal.issue-text(OnlineGlobal.preview-issue, OnlineGlobal.preview-detail);
                    color: Theme.text;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    for q in OnlineGlobal.qualities: Button {
                        text: @tr("Play at {}", q);
                        clicked => { OnlineGlobal.play-link(root.search-query, q); }
                    }
                }
            }
            if root.is-link: Rectangle { vertical-stretch: 1; }

            // Results count label
        Rectangle {
                height: 26px;
                width: 100%;
                background: Theme.surface;
                visible: !root.catalog && !root.is-link && root.search-query != "";

                Text {
                    x: 12px;
                    y: (parent.height - self.height) / 2;
                    text: root.search-results.length == 0
                        ? @tr("No results found")
                        : @tr("{} result(s) found", root.search-results.length);
                    color: Theme.text-tertiary;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }

            // Results list
        if !root.catalog && !root.is-link && root.search-query != "":
            ListView {
                horizontal-stretch: 1;

                for item in root.search-results: SongItem {
                    info: item;
                    playing: item.id == root.current-song.id;
                    double_clicked => {
                        root.play-song(item);
                    }
                }
            }

            // Empty state - show hint when no query
        if root.search-query == "":
            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;

                VerticalLayout {
                    width: 100%;
                    height: 100%;
                    alignment: center;
                    spacing: 8px;

                    IconDisplay {
                        x: (parent.width - self.width) / 2;
                        icon: IconSet.Search;
                        size: 44px;
                        stroke: Theme.text-tertiary;
                        stroke-width: 1.8;
                    }

                    Text {
                        text: @tr("Type to search songs");
                        color: Theme.text-tertiary;
                        font-size: 14px;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}
