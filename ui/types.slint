export struct SongInfo {
    id: string,
    song_name: string,
    singer: string,
    duration: string,
}

@rust-attr(derive(serde::Serialize, serde::Deserialize))
export enum SortKey {
    BySongName,
    BySinger,
    ByDuration,
}

@rust-attr(derive(serde::Serialize, serde::Deserialize))
export enum LoopMode {
    None,
    Track,
    Playlist,
}

export struct LyricItem {
    time: float,
    duration: float,
    text: string,
}

export enum OnlineIssue {
    None,
    InvalidLink,
    NoScript,
    NoQuality,
    ScriptFile,
    Initialization,
    Resolve,
    Transfer,
    Decode,
}
