export struct SongInfo {
    id: string,
    song_name: string,
    singer: string,
    album: string,
    duration: string,
    is-local: bool,
}

export enum SortKey {
    BySongName,
    BySinger,
    ByDuration,
}

export enum LoopMode {
    None,
    Track,
    Playlist,
}

export struct LyricWord {
    text: string,
    space-after: bool,
}

export struct LyricItem {
    time: float,
    text: string,
    translation: string,
    words: [LyricWord],
}

export enum OnlineIssue {
    None,
    InvalidLink,
    NoScript,
    NoQuality,
    ScriptFile,
    Initialization,
    Resolve,
    Transfer,
    Decode,
}
