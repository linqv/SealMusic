import { Icon, IconDisplay, IconSet } from "@lucide";
import { Slider } from "std-widgets.slint";
import { LikeButton } from "collections.slint";
import { Theme } from "theme.slint";
import { LoopMode, SongInfo } from "types.slint";

export component PlaybackButton inherits Rectangle {
    in property <Icon> icon;
    in property <string> label;
    in property <length> icon-size: 16px;
    in property <bool> filled;
    in property <bool> active;
    in property <bool> prominent;
    in property <bool> subtle;
    in property <bool> round;
    in property <bool> animate-transitions: true;
    out property <bool> hovered: touch.has-hover;
    callback clicked();

    width: 36px;
    height: 36px;
    border-radius: root.round ? self.height / 2 : 8px;
    background: touch.pressed
        ? (root.subtle || root.prominent ? Theme.text.with-alpha(0.18) : Theme.press)
        : touch.has-hover
            ? (root.subtle || root.prominent ? Theme.text.with-alpha(0.12) : Theme.hover)
            : (root.prominent ? Theme.text.with-alpha(0.11) : transparent);
    animate background {
        duration: 120ms;
        enabled: root.animate-transitions;
    }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    IconDisplay {
        icon: root.icon;
        size: root.icon-size;
        stroke: root.active ? Theme.accent : root.filled || touch.has-hover ? Theme.text : Theme.text.with-alpha(root.subtle ? 0.52 : 0.6);
        stroke-fill: root.filled ? Theme.text : transparent;
        stroke-width: root.filled ? 1.2 : 1.8;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component VolumeButton inherits PlaybackButton {
    in-out property <float> volume;
    callback change-volume(float);

    icon: root.volume > 0 ? IconSet.Volume2 : IconSet.VolumeX;
    icon-size: 19px;
    label: @tr("Volume");
    active: volume-popup.is-open;
    accessible-expandable: true;
    accessible-expanded: volume-popup.is-open;
    clicked => { volume-popup.show(); }

    volume-popup := PopupWindow {
        x: (root.width - self.width) / 2;
        y: -self.height - 2px;
        width: 64px;
        height: 182px;
        close-policy: close-on-click-outside;
        forward-focus: popup-keys;

        popup-keys := FocusScope {
            forward-focus: volume-slider;
            key-pressed(event) => {
                if event.text == Key.Escape {
                    volume-popup.close();
                    return accept;
                }
                return reject;
            }

            Path {
                x: (parent.width - self.width) / 2;
                y: card.y + card.height - 2px;
                width: 14px;
                height: 8px;
                viewbox-width: 14;
                viewbox-height: 8;
                commands: "M 0 0 L 7 7 L 14 0 Z";
                fill: Theme.panel;
                stroke: Theme.border;
                stroke-width: 1px;
            }

            card := Rectangle {
                x: (parent.width - self.width) / 2;
                y: 4px;
                width: 52px;
                height: 168px;
                background: Theme.panel;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: 12px;
                drop-shadow-color: #00000026;
                drop-shadow-offset-y: 2px;
                drop-shadow-blur: 6px;

                Text {
                    y: 10px;
                    width: 100%;
                    horizontal-alignment: center;
                    text: "\{round(root.volume * 100)}%";
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.text-secondary;
                }

                volume-slider := Slider {
                    x: (parent.width - self.width) / 2;
                    y: 32px;
                    width: 28px;
                    height: 126px;
                    minimum: 0;
                    maximum: 1;
                    step: 0.01;
                    orientation: vertical;
                    accessible-label: root.label;
                    value <=> root.volume;
                    released(v) => { root.change-volume(v); }
                }
            }
        }
    }
}

export component SeekBar inherits Rectangle {
    in property <bool> enabled;
    in property <float> position;
    in property <float> duration;
    in property <string> track;
    in property <bool> atmospheric;
    out property <float> displayed-position: touch.pressed && root.drag-track == root.track
        ? root.preview-position : root.position;
    callback seek(float);
    private property <string> drag-track;
    private property <float> preview-position;
    private property <float> pointer-position: (touch.mouse-x / max(1px, touch.width)).clamp(0, 1) * root.duration;
    private property <length> track-height: root.atmospheric
        ? (root.enabled && (touch.has-hover || touch.pressed) ? 7px : 5px)
        : 4px;

    forward-focus: seek-keys;
    accessible-role: slider;
    accessible-label: @tr("Playback position");
    accessible-enabled: root.enabled;
    accessible-orientation: horizontal;
    accessible-value: root.displayed-position;
    accessible-value-minimum: 0;
    accessible-value-maximum: root.duration;
    accessible-value-step: 1;
    accessible-action-set-value(value) => {
        if root.enabled && value.is-float() {
            root.seek(value.to-float().clamp(0, root.duration));
        }
    }
    accessible-action-increment => {
        if root.enabled { root.seek(min(root.duration, root.position + 1)); }
    }
    accessible-action-decrement => {
        if root.enabled { root.seek(max(0, root.position - 1)); }
    }

    Rectangle {
        y: (parent.height - self.height) / 2;
        width: 100%;
        height: root.track-height;
        border-radius: self.height / 2;
        background: Theme.text.with-alpha(root.atmospheric ? 0.18 : 0.1);
        animate height { duration: 140ms; easing: ease-out; }

        Rectangle {
            x: 0px;
            width: parent.width * (root.displayed-position / max(0.001, root.duration)).clamp(0, 1);
            visible: root.duration > 0 && root.displayed-position > 0;
            height: 100%;
            border-radius: parent.border-radius;
            background: root.enabled && (touch.has-hover || touch.pressed)
                ? Theme.text
                : Theme.text.with-alpha(root.atmospheric ? 0.78 : 0.75);
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        moved => { root.preview-position = root.pointer-position; }
        pointer-event(event) => {
            if event.button == PointerEventButton.left {
                if event.kind == PointerEventKind.down {
                    root.preview-position = root.pointer-position;
                    root.drag-track = root.track;
                } else if event.kind == PointerEventKind.up && root.drag-track == root.track {
                    root.seek(root.pointer-position);
                }
            }
        }
    }

    seek-keys := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Home {
                root.seek(0);
                return accept;
            }
            if event.text == Key.End {
                root.seek(root.duration);
                return accept;
            }
            return reject;
        }
    }
}

export component TransportButtons inherits HorizontalLayout {
    in property <bool> paused;
    in property <bool> shuffle;
    in property <LoopMode> loop-mode;
    in property <bool> expanded;
    in property <bool> animate-transitions: true;
    callback toggle-play();
    callback play-next();
    callback play-prev();
    callback set-shuffle(bool);
    callback switch-mode(LoopMode);

    height: root.expanded ? 48px : 40px;
    alignment: center;
    spacing: root.expanded ? max(4px, (root.width - 208px) / 4) : 6px;

    PlaybackButton {
        y: (parent.height - self.height) / 2;
        icon: IconSet.Shuffle;
        icon-size: root.expanded ? 16px : 16px;
        active: root.shuffle;
        subtle: root.expanded;
        round: root.expanded;
        animate-transitions: root.animate-transitions;
        label: @tr("Shuffle");
        accessible-checkable: true;
        accessible-checked: root.shuffle;
        clicked => { root.set-shuffle(!root.shuffle); }
    }
    PlaybackButton {
        y: (parent.height - self.height) / 2;
        width: root.expanded ? 40px : 36px;
        height: root.expanded ? 40px : 36px;
        icon: IconSet.Rewind;
        icon-size: root.expanded ? 22px : 16px;
        filled: true;
        subtle: root.expanded;
        round: root.expanded;
        animate-transitions: root.animate-transitions;
        label: @tr("Previous track");
        clicked => { root.play-prev(); }
    }
    PlaybackButton {
        width: root.expanded ? 52px : 44px;
        height: root.expanded ? 48px : root.height;
        icon-size: root.expanded ? 30px : 23px;
        subtle: root.expanded;
        round: root.expanded;
        icon: root.paused ? IconSet.Play : IconSet.Pause;
        filled: true;
        animate-transitions: root.animate-transitions;
        label: root.paused ? @tr("Play") : @tr("Pause");
        clicked => { root.toggle-play(); }
    }
    PlaybackButton {
        y: (parent.height - self.height) / 2;
        width: root.expanded ? 40px : 36px;
        height: root.expanded ? 40px : 36px;
        icon: IconSet.FastForward;
        icon-size: root.expanded ? 22px : 16px;
        filled: true;
        subtle: root.expanded;
        round: root.expanded;
        animate-transitions: root.animate-transitions;
        label: @tr("Next track");
        clicked => { root.play-next(); }
    }
    PlaybackButton {
        y: (parent.height - self.height) / 2;
        icon: root.loop-mode == LoopMode.Track ? IconSet.Repeat1 : IconSet.Repeat;
        icon-size: root.expanded ? 16px : 16px;
        active: root.loop-mode != LoopMode.None;
        subtle: root.expanded;
        round: root.expanded;
        animate-transitions: root.animate-transitions;
        label: root.loop-mode == LoopMode.Track ? @tr("Repeat track") : @tr("Repeat playlist");
        accessible-checkable: true;
        accessible-checked: root.loop-mode != LoopMode.None;
        clicked => {
            if root.loop-mode == LoopMode.Playlist {
                root.switch-mode(LoopMode.Track);
            } else if root.loop-mode == LoopMode.Track {
                root.switch-mode(LoopMode.None);
            } else {
                root.switch-mode(LoopMode.Playlist);
            }
        }
    }
}

export component ControlPanel inherits Rectangle {
    height: 84px;
    background: Theme.surface;

    in property <float> progress;
    in property <bool> can-seek;
    in property <float> duration;
    in property <bool> paused;
    in property <LoopMode> loop_mode;
    in property <bool> shuffle;
    in property <SongInfo> current_song;
    in property <image> album_image;
    in-out property <float> volume;

    callback change-progress(float);
    callback toggle-play();
    callback play-next();
    callback play-prev();
    callback set-shuffle(bool);
    callback switch-mode(LoopMode);
    callback change-volume(float);
    callback open-now-playing();
    pure callback format-duration(float) -> string;

    private property <bool> has-track: root.current_song.id != "";
    private property <length> side-padding: 18px;

    HorizontalLayout {
        x: root.side-padding;
        y: (parent.height - self.height) / 2;
        width: min(270px, transport.x - self.x - 16px);
        height: 48px;
        spacing: 4px;

        cover-button := Rectangle {
            width: 48px;
            height: 48px;
            border-radius: 8px;
            background: Theme.panel;
            drop-shadow-color: #00000030;
            drop-shadow-blur: 6px;
            drop-shadow-offset-y: 2px;
            forward-focus: cover-focus;
            accessible-role: button;
            accessible-label: @tr("Open lyrics and play queue");
            accessible-action-default => { root.open-now-playing(); }

            Rectangle {
                border-radius: 8px;
                clip: true;
                Image {
                    width: 100%;
                    height: 100%;
                    source: root.has-track ? root.album_image : @image-url("cover.svg");
                    image-fit: cover;
                }
                Rectangle {
                    opacity: cover-touch.has-hover || cover-focus.has-focus ? 1 : 0;
                    animate opacity { duration: 120ms; }
                    background: #00000069;
                    IconDisplay {
                        icon: IconSet.ChevronsUp;
                        size: 22px;
                        stroke: white;
                    }
                }
            }
            cover-focus := FocusScope {
                focus-on-click: false;
                key-pressed(event) => {
                    if event.text == Key.Space || event.text == Key.Return {
                        root.open-now-playing();
                        return accept;
                    }
                    return reject;
                }
            }
            cover-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open-now-playing(); }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            padding-left: 8px;
            spacing: 2px;
            Text {
                text: root.has-track ? root.current_song.song_name : @tr("No track selected");
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
            }
            if root.current_song.singer != "": Text {
                text: root.current_song.singer;
                font-size: 12px;
                color: Theme.text.with-alpha(0.6);
                overflow: elide;
            }
        }

        if root.has-track: LikeButton {
            track: root.current_song.id;
        }
    }

    transport := VerticalLayout {
        x: max(220px, (parent.width - self.width) / 2);
        y: (parent.height - self.height) / 2;
        width: (parent.width * 0.42).clamp(280px, 520px);
        height: 60px;

        TransportButtons {
            paused: root.paused;
            shuffle: root.shuffle;
            loop-mode: root.loop_mode;
            toggle-play => { root.toggle-play(); }
            play-next => { root.play-next(); }
            play-prev => { root.play-prev(); }
            set-shuffle(value) => { root.set-shuffle(value); }
            switch-mode(mode) => { root.switch-mode(mode); }
        }

        HorizontalLayout {
            height: 20px;
            spacing: 8px;
            Text {
                width: 36px;
                horizontal-alignment: right;
                vertical-alignment: center;
                text: root.format-duration(seek-bar.displayed-position);
                font-size: 11px;
                color: Theme.text.with-alpha(0.6);
            }
            seek-bar := SeekBar {
                horizontal-stretch: 1;
                enabled: root.can-seek && root.duration > 0;
                position: root.progress;
                duration: root.duration;
                track: root.current_song.id;
                seek(v) => { root.change-progress(v); }
            }
            Text {
                width: 36px;
                vertical-alignment: center;
                text: root.duration > 0 ? root.format-duration(root.duration) : "–:––";
                font-size: 11px;
                color: Theme.text.with-alpha(0.6);
            }
        }
    }

    VolumeButton {
        x: parent.width - self.width - root.side-padding;
        y: (parent.height - self.height) / 2;
        volume <=> root.volume;
        change-volume(v) => { root.change-volume(v); }
    }
}
