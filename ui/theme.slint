// SealMusic Custom Theme — Fluent-inspired
// Two complete palettes: light (is-dark = false) and dark (is-dark = true)
import { Palette } from "std-widgets.slint";

export global Theme {
    in-out property <bool> is-dark;

    // Panel background — sidebar and settings cards
    out property <color> panel: is-dark ? Palette.background.brighter(0.40) : Palette.background.darker(0.02);
    // Content surface — main area, cards, controls
    out property <color> surface: is-dark ? Palette.background.darker(0.40) : Palette.background.brighter(1.);
    // Hover state — items, buttons
    out property <color> hover: is-dark ? Palette.background.brighter(0.80) : Palette.background.darker(0.04);
    // Song list hover — softer contrast than general hover
    out property <color> song-hover: is-dark ? Palette.background.brighter(0.10) : Palette.background;
    // Pressed state — items, buttons
    out property <color> press: is-dark ? Palette.background.brighter(0.70) : Palette.background.darker(0.04);

    // === Text ===
    out property <color> text: Palette.foreground;
    out property <color> text-secondary: is-dark ? Palette.foreground.darker(0.3) : Palette.foreground.brighter(0.3);
    out property <color> text-tertiary: is-dark ? Palette.foreground.darker(0.3) : Palette.background.darker(0.7);

    // === Borders & Dividers ===
    out property <color> border: is-dark ? Palette.background.brighter(1.5) : Palette.background.darker(0.1);
    out property <color> divider: is-dark ? Palette.background.brighter(1.5) : Palette.background.darker(0.1);

    // === Accent (Fluent blue) ===
    out property <color> accent: Palette.accent-background;

    // === Cover Art Recoloring (ported from Amberol) ===
    in-out property <bool> cover-recoloring: true;
    in-out property <bool> has-cover-palette: false;
    in-out property <int> cover-color-count: 0;
    in-out property <color> cover-color-0: cover-surface;
    in-out property <color> cover-color-1: cover-surface;
    in-out property <color> cover-color-2: cover-surface;

    // Adwaita window colors beneath Amberol's translucent cover gradients.
    out property <color> cover-surface: is-dark ? #222226 : #fafafb;
    out property <color> cover-secondary: cover-color-count >= 2 ? cover-color-1 : cover-surface;
    out property <bool> cover-active: cover-recoloring && has-cover-palette && cover-color-count > 0;
}

export component CoverBackdrop inherits Rectangle {
    in property <color> base-color: Theme.surface;
    background: Theme.cover-active ? Theme.cover-surface : root.base-color;
    clip: true;

    private property <color> c0: Theme.cover-color-0;
    private property <color> c1: Theme.cover-secondary;
    private property <color> c2: Theme.cover-color-count >= 3 ? Theme.cover-color-2 : Theme.cover-surface;
    private property <float> tint-alpha: Theme.cover-active ? 0.55 : 0.0;

    animate background, c0, c1, c2, tint-alpha {
        duration: 250ms;
        easing: ease;
    }

    // CSS paints the first gradient on top. Slint paints later siblings on top.
    Rectangle {
        width: 100%;
        height: 100%;
        visible: root.tint-alpha > 0.001;
        background: @linear-gradient(336deg, root.c2.with-alpha(root.tint-alpha) 0%, root.c2.with-alpha(0.0) 70.71%);
    }

    Rectangle {
        width: 100%;
        height: 100%;
        visible: root.tint-alpha > 0.001;
        background: @linear-gradient(217deg, root.c1.with-alpha(root.tint-alpha) 0%, root.c1.with-alpha(0.0) 70.71%);
    }

    Rectangle {
        width: 100%;
        height: 100%;
        visible: root.tint-alpha > 0.001;
        background: @linear-gradient(127deg, root.c0.with-alpha(root.tint-alpha) 0%, root.c0.with-alpha(0.0) 70.71%);
    }
}
