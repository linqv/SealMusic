import { OnlineIssue, SongInfo } from "types.slint";

export struct CatalogRow {
    song: SongInfo,
    source: string,
}

export global OnlineGlobal {
    in property <bool> available;
    in-out property <string> search-source;
    in property <string> catalog-source;
    in property <string> catalog-query;
    in property <int> catalog-page;
    in property <bool> catalog-busy;
    in property <bool> catalog-failed;
    in property <bool> catalog-next;
    in property <bool> catalog-partial-failure;
    in property <[CatalogRow]> catalog-rows;
    callback search-catalog(string, string, int);
    callback cancel-catalog();
    callback play-catalog(string);
    in property <bool> installed;
    in-out property <bool> enabled;
    in-out property <string> quality: "320k";
    in property <bool> importing;
    in property <string> script-summary;
    in property <string> preview-query;
    in property <OnlineIssue> preview-issue;
    in property <string> preview-detail;
    in property <string> preview-track;
    in property <string> loading;
    in property <bool> loading-paused;
    pure callback is-link(string) -> bool;
    pure callback is-blank(string) -> bool;
    in property <bool> local-playback;
    callback play-local-source(string);
    callback import-script();
    callback enable-script(bool);
    callback play-link(string);
    callback set-quality(string);

    public pure function quality-name(quality: string) -> string {
        if quality == "128k" { return @tr("Standard (128k)"); }
        if quality == "320k" { return @tr("High (320k)"); }
        if quality == "flac" { return @tr("Lossless (FLAC)"); }
        if quality == "flac24bit" { return @tr("Hi-Res (24-bit)"); }
        return quality;
    }

    public pure function source-name(source: string) -> string {
        if source == "all" { return @tr("All platforms"); }
        if source == "kw" { return @tr("Kuwo"); }
        if source == "kg" { return @tr("Kugou"); }
        if source == "tx" { return @tr("QQ Music"); }
        if source == "wy" { return @tr("NetEase"); }
        if source == "mg" { return @tr("Migu"); }
        return source;
    }

    public pure function issue-text(issue: OnlineIssue, detail: string) -> string {
        if issue == OnlineIssue.InvalidLink { return @tr("Invalid LX link or missing field: {}", detail); }
        if issue == OnlineIssue.NoScript { return @tr("Enable an LX source in Settings."); }
        if issue == OnlineIssue.NoQuality { return @tr("No compatible audio quality is available."); }
        if issue == OnlineIssue.ScriptFile { return @tr("Could not read or save the LX source."); }
        if issue == OnlineIssue.Initialization { return @tr("The LX source failed to initialize."); }
        if issue == OnlineIssue.Resolve { return @tr("The source could not resolve the media URL ({}).", detail); }
        if issue == OnlineIssue.Transfer { return @tr("Media download failed ({}).", detail); }
        if issue == OnlineIssue.Decode { return @tr("Audio decoding failed ({}).", detail); }
        return "";
    }
}
