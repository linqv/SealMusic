import { CatalogRow, OnlineGlobal } from "online.slint";
export { CatalogRow, OnlineGlobal }
import { CollectionPicker, CollectionsGlobal } from "collections.slint";
export { CollectionsGlobal }
import { Theme } from "theme.slint";
export { Theme }
import { Palette } from "std-widgets.slint";
import { IconDisplay, IconSet } from "@lucide";
import { ControlPanel } from "control_panel.slint";
import { Sidebar } from "sidebar.slint";
import { NowPlaying } from "lyrics_panel.slint";
import {
    SongListView,
    MessagePopup,
} from "song_list.slint";
import { SettingsPanel } from "settings_panel.slint";
import { SearchPanel } from "search_panel.slint";
import {
    OnlineIssue,
    LoopMode,
    LyricItem,
    LyricWord,
    SongInfo,
    SortKey,
} from "types.slint";

export {
    OnlineIssue,
    LoopMode,
    LyricItem,
    LyricWord,
    SongInfo,
    SortKey,
}

// === Group 1: Audio playback engine state ===
export global PlaybackGlobal {
    in property <bool> can-seek;
    in-out property <float> progress;
    in-out property <float> duration;
    in-out property <bool> paused;
    in-out property <LoopMode> loop_mode;
    in-out property <bool> shuffle;
    in-out property <float> volume;
}

// === Group 2: All display & settings state ===
export global DisplayGlobal {
    in-out property <SongInfo> current_song;
    in-out property <[LyricItem]> lyrics;
    in-out property <int> active_lyric_index: -1;
    in-out property <float> lyric_time: 0;
    in property <[SongInfo]> upcoming;
    in property <image> album_image;
    in property <image> ambient_image;
    in property <bool> has_ambient_image;
    in-out property <string> song_dir;

    in-out property <SortKey> sort_key;
    in-out property <bool> sort_ascending: true;
    in-out property <string> lang;
    in-out property <bool> light_ui;
    in-out property <bool> follow_system_theme;
    in property <[SongInfo]> library_songs;
    in-out property <[SongInfo]> search_results;
    in-out property <string> search_query;
    in-out property <string> app-font-family;
    in-out property <length> gallery_viewport_y: 0px;
}

export component AppTray inherits SystemTrayIcon {
    icon: @image-url("cover.svg");
    tooltip: "SealMusic";

    callback show-window();
    callback rescan-songs();
    callback toggle-play();
    callback stop();
    callback next();
    callback previous();
    callback exit-app();

    clicked => { root.show-window(); }

    Menu {
        MenuItem {
            title: @tr("Show Window");
            activated => { root.show-window(); }
        }

        MenuItem {
            title: @tr("Play / Pause");
            activated => { root.toggle-play(); }
        }
        MenuItem {
            title: @tr("Stop");
            activated => { root.stop(); }
        }
        MenuItem {
            title: @tr("Previous");
            activated => { root.previous(); }
        }
        MenuItem {
            title: @tr("Next");
            activated => { root.next(); }
        }
        MenuItem {
            title: @tr("Rescan Songs");
            activated => { root.rescan-songs(); }
        }

        MenuItem {
            title: @tr("Exit");
            activated => { root.exit-app(); }
        }
    }
}

export component MainWindow inherits Window {
    default-font-family <=> DisplayGlobal.app-font-family;
    default-font-size: 14px;
    preferred-width: 900px;
    preferred-height: 510px;
    min-width: 850px;
    min-height: 500px;
    title: "SealMusic";
    icon: @image-url("cover.svg");
    no-frame: true;
    resize-border-width: root.maximized ? 0px : 5px;
    background: transparent;
    forward-focus: content-pane;
    callback toggle_play();
    callback play(SongInfo);
    callback play_queued(string);
    callback play_next();
    callback play_prev();
    callback change_progress(float);
    callback seek_relative(int);
    callback quit();
    callback set_shuffle(bool);
    callback switch_mode(LoopMode);
    callback sort_song_list(SortKey, bool);
    callback set_lang(string);
    callback change_volume(float);
    callback set_follow_system_theme(bool);
    callback select_song_dir();
    callback search_songs(string);
    pure callback format_duration(float) -> string;
    pure callback open_url_in_browser(string);
    pure callback prev-lyric-time(float, [LyricItem]) -> float;
    pure callback next-lyric-time(float, [LyricItem]) -> float;
    callback page_changed(int);
    callback lyrics_visibility_changed();
    callback queue_visibility_changed();
    callback now_playing_sliding_changed();
    in property <string> version;
    in-out property <int> current_page: 0;
    private property <bool> now-playing-open;
    private property <float> now-playing-offset: root.now-playing-open ? 0 : 1;
    animate now-playing-offset {
        duration: 320ms;
        easing: ease-in-out;
    }
    private property <bool> raw-now-playing-sliding:
        root.now-playing-open ? root.now-playing-offset > 0 : root.now-playing-offset < 1;
    private property <bool> raw-now-playing-visible: root.now-playing-offset < 1;
    private property <bool> raw-main-view-visible: root.now-playing-offset > 0;
    // Latched edge-triggered flags so descendants (and Layer ItemCache trackers)
    // do not subscribe to per-frame `now-playing-offset` updates during a slide.
    out property <bool> now-playing-sliding: false;
    private property <bool> now-playing-visible: false;
    private property <bool> now-playing-resting-open: false;
    private property <bool> main-view-visible: true;
    private property <bool> show-queue;
    out property <bool> queue-visible: root.show-queue && root.now-playing-visible;
    out property <bool> lyrics-visible: root.now-playing-open && !root.show-queue;

    public function follow-lyrics() { now-playing.follow-lyrics(); }
    in-out property <bool> sidebar_expanded: false;
    in-out property <string> operation_error_message: "";
    public function set_light_theme(yes: bool) {
        DisplayGlobal.light_ui = yes;
        Theme.is-dark = !yes;
        if (yes) {
            Palette.color-scheme = ColorScheme.light;
        } else {
            Palette.color-scheme = ColorScheme.dark;
        }
    }
    in property <string> update-message;
    in property <string> update-url;
    public function show-source-update() { update-popup.show(); }
    public function show_operation_error() {
        operation-popup.show();
    }
    public function show_collection_save_error() {
        root.operation_error_message = @tr("Could not save collections.");
        operation-popup.show();
    }
    function close-collection-picker() {
        CollectionsGlobal.picker-anchor.track = "";
    }
    function sync-now-playing-flags() {
        root.now-playing-sliding = root.raw-now-playing-sliding;
        root.now-playing-visible = root.raw-now-playing-visible;
        root.main-view-visible = root.raw-main-view-visible;
        root.now-playing-resting-open = root.now-playing-open && !root.now-playing-sliding;
    }
    function set-now-playing(open: bool) {
        root.close-collection-picker();
        if open && root.now-playing-offset == 1 { root.show-queue = false; }
        root.now-playing-open = open;
        root.sync-now-playing-flags();
        root.focus();
    }
    function navigate(page: int) {
        root.now-playing-open = false;
        root.sync-now-playing-flags();
        root.current_page = page;
        root.page_changed(page);
        root.focus();
    }
    changed raw-now-playing-sliding => { root.sync-now-playing-flags(); }
    changed raw-now-playing-visible => { root.sync-now-playing-flags(); }
    changed raw-main-view-visible => { root.sync-now-playing-flags(); }
    changed lyrics-visible => { root.lyrics_visibility_changed(); }
    changed queue-visible => { root.queue_visibility_changed(); }
    changed now-playing-sliding => { root.now_playing_sliding_changed(); }
    changed current_page => { root.close-collection-picker(); }
    changed width => { root.close-collection-picker(); }
    changed height => { root.close-collection-picker(); }
    window-frame := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.maximized || root.now-playing-sliding ? 0px : 6px;
        background: Theme.panel;
        clip: true;

        loading-strip := Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: OnlineGlobal.loading == "" ? 0px : 28px;
            clip: true;
            background: Theme.panel;
            Text {
                x: 12px;
                width: parent.width - 60px;
                text: OnlineGlobal.loading-paused
                    ? @tr("Loading {} (paused)", OnlineGlobal.loading)
                    : @tr("Loading {}", OnlineGlobal.loading);
                color: Theme.text-secondary;
                overflow: elide;
            }
        }

        content-pane := FocusScope {
            x: 0px;
            y: loading-strip.height;
            width: 100%;
            height: root.height - self.y;

            Rectangle {
                x: 0px;
                y: 0px;
                width: 100%;
                height: root.now-playing-sliding
                    ? min(parent.height, now-playing-layer.y + 1px)
                    : parent.height;
                clip: root.now-playing-sliding;
                visible: root.main-view-visible;

                HorizontalLayout {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: content-pane.height;
                    Sidebar {
                        expanded <=> root.sidebar_expanded;
                        current_page: root.current_page;
                        change_page(page) => { root.navigate(page); }
                        request_focus => { root.focus(); }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;

                        Rectangle {
                            vertical-stretch: 1;
                            border-top-left-radius: 10px;
                            clip: true;

                            if root.current_page == 0: SongListView {
                                width: 100%;
                                height: 100%;
                                ascending <=> DisplayGlobal.sort_ascending;
                                sort-key <=> DisplayGlobal.sort_key;
                                scroll-y <=> DisplayGlobal.gallery_viewport_y;
                                current-song: DisplayGlobal.current_song;
                                sort-songs(key, asc) => { root.sort_song_list(key, asc); }
                                browse => { root.navigate(1); }
                            }

                            if root.current_page == 1: SearchPanel {
                                x: 0px;
                                y: 0px;
                                width: 100%;
                                height: 100%;
                                search-query <=> DisplayGlobal.search_query;
                                library-songs: DisplayGlobal.library_songs;
                                search-results <=> DisplayGlobal.search_results;
                                current-song <=> DisplayGlobal.current_song;
                                search(query) => {
                                    root.search_songs(query);
                                }
                                play-song(info) => {
                                    root.play(info);
                                }
                            }

                            if root.current_page == 3: Rectangle {
                                width: 100%;
                                height: 100%;
                                background: Theme.surface;
                                TouchArea {
                                    clicked => {
                                        root.focus();
                                    }
                                }

                                SettingsPanel {
                                    width: 100%;
                                    height: 100%;
                                    version: root.version;
                                    open-upstream => { root.open_url_in_browser("https://github.com/Jordan-Haidee/zeedle"); }
                                    song_dir <=> DisplayGlobal.song_dir;
                                    lang <=> DisplayGlobal.lang;
                                    follow_system_theme <=> DisplayGlobal.follow_system_theme;
                                    light_ui <=> DisplayGlobal.light_ui;
                                    cover_recoloring <=> Theme.cover-recoloring;
                                    set_lang(l) => {
                                        root.set_lang(l);
                                    }
                                    set_follow_system_theme(yes) => {
                                        root.set_follow_system_theme(yes);
                                    }
                                    set_light_theme(yes) => {
                                        root.set_light_theme(yes);
                                    }
                                    select_song_dir => {
                                        root.select_song_dir();
                                    }
                                }
                            }
                        }

                        ControlPanel {
                            can-seek: PlaybackGlobal.can-seek;
                            progress: PlaybackGlobal.progress;
                            duration: PlaybackGlobal.duration;
                            paused: PlaybackGlobal.paused;
                            shuffle: PlaybackGlobal.shuffle;
                            loop_mode: PlaybackGlobal.loop_mode;
                            current_song: DisplayGlobal.current_song;
                            album_image: DisplayGlobal.album_image;
                            volume <=> PlaybackGlobal.volume;
                            change-progress(pos) => { root.change_progress(pos); root.focus(); }
                            toggle-play => { root.toggle_play(); }
                            play-next => { root.play_next(); }
                            play-prev => { root.play_prev(); }
                            set-shuffle(value) => { root.set_shuffle(value); }
                            switch-mode(mode) => { root.switch_mode(mode); }
                            change-volume(value) => { root.change_volume(value); }
                            open-now-playing => { root.set-now-playing(true); }
                            format-duration(value) => { return root.format_duration(value); }
                        }
                    }
                }
            }

            now-playing-layer := Rectangle {
                x: 0px;
                y: parent.height * root.now-playing-offset;
                width: 100%;
                height: 100%;
                cache-rendering-hint: root.now-playing-sliding && root.now-playing-visible;

                now-playing := NowPlaying {
                    width: 100%;
                    height: 100%;
                    visible: root.now-playing-visible;
                    sliding: root.now-playing-sliding;
                    resting-open: root.now-playing-resting-open;
                    album-image: DisplayGlobal.album_image;
                    ambient-image: DisplayGlobal.ambient_image;
                    has-ambient-image: DisplayGlobal.has_ambient_image;
                    current-song: DisplayGlobal.current_song;
                    upcoming: DisplayGlobal.upcoming;
                    lyrics: DisplayGlobal.lyrics;
                    active-lyric-index: DisplayGlobal.active_lyric_index;
                    lyric-time: DisplayGlobal.lyric_time;
                    show-queue <=> root.show-queue;
                    can-seek: PlaybackGlobal.can-seek;
                    progress: PlaybackGlobal.progress;
                    duration: PlaybackGlobal.duration;
                    paused: PlaybackGlobal.paused;
                    shuffle: PlaybackGlobal.shuffle;
                    loop-mode: PlaybackGlobal.loop_mode;
                    volume <=> PlaybackGlobal.volume;
                    dismiss => { root.set-now-playing(false); }
                    seek(pos) => { root.change_progress(pos); root.focus(); }
                    toggle-play => { root.toggle_play(); }
                    play-next => { root.play_next(); }
                    play-prev => { root.play_prev(); }
                    play-queued(id) => { root.play_queued(id); }
                    set-shuffle(value) => { root.set_shuffle(value); }
                    switch-mode(mode) => { root.switch_mode(mode); }
                    change-volume(value) => { root.change_volume(value); }
                    format-duration(value) => { return root.format_duration(value); }
                }
            }

            TouchArea {
                enabled: root.now-playing-sliding;
                scroll-event => { return accept; }
            }

            key-pressed(event) => {
                if event.text == Key.Escape && root.now-playing-open {
                    root.set-now-playing(false);
                    return accept;
                }
                return reject;
            }

            KeyBinding {
                keys: @keys(Control + Q);
                activated => { root.quit(); }
            }

            KeyBinding {
                keys: @keys(Space);
                activated => { root.toggle_play(); root.focus(); }
            }

            KeyBinding {
                keys: @keys(RightArrow);
                activated => {
                    if (root.lyrics-visible && DisplayGlobal.lyrics.length > 0) {
                        root.change_progress(root.next-lyric-time(PlaybackGlobal.progress, DisplayGlobal.lyrics));
                    } else {
                        root.seek_relative(15);
                    }
                    root.focus();
                }
            }

            KeyBinding {
                keys: @keys(DownArrow);
                activated => { root.play_next(); root.focus(); }
            }

            KeyBinding {
                keys: @keys(LeftArrow);
                activated => {
                    if (root.lyrics-visible && DisplayGlobal.lyrics.length > 0) {
                        root.change_progress(root.prev-lyric-time(PlaybackGlobal.progress, DisplayGlobal.lyrics));
                    } else {
                        root.seek_relative(-15);
                    }
                    root.focus();
                }
            }

            KeyBinding {
                keys: @keys(UpArrow);
                activated => { root.play_prev(); root.focus(); }
            }

            KeyBinding {
                keys: @keys(F1);
                activated => { root.navigate(0); }
            }

            KeyBinding {
                keys: @keys(F2);
                activated => { root.navigate(1); }
            }

            KeyBinding {
                keys: @keys(F3);
                activated => { root.set-now-playing(!root.now-playing-open); }
            }

            KeyBinding {
                keys: @keys(F4);
                activated => { root.navigate(3); }
            }
        }

        close-button := Rectangle {
            property <color> button-surface: root.now-playing-open && Theme.cover-active
                ? Theme.surface.mix(Theme.cover-color-0, 0.7)
                : Theme.surface;

            x: parent.width - self.width - 10px;
            y: 10px;
            width: 24px;
            height: self.width;
            border-radius: self.width / 2;
            background: self.button-surface.mix(Theme.text, close-touch.pressed ? 0.76 : close-touch.has-hover ? 0.82 : 0.88);
            border-width: close-focus.has-focus ? 1px : 0px;
            border-color: Theme.accent;
            animate background { duration: 150ms; }
            forward-focus: close-focus;
            accessible-role: button;
            accessible-label: @tr("Close window");
            accessible-action-default => { root.close(); }

            IconDisplay {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                icon: IconSet.X;
                size: 14px;
                stroke: Theme.text;
                stroke-width: 3;
            }

            close-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.close(); }
            }

            close-focus := FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Space || event.text == Key.Return {
                        root.close();
                        return accept;
                    }
                    return reject;
                }
            }
        }

        if CollectionsGlobal.picker-anchor.track != "": FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.close-collection-picker();
                    return accept;
                }
                return reject;
            }

            TouchArea {
                clicked => { root.close-collection-picker(); }
                scroll-event => { return accept; }
            }

            CollectionPicker {
                x: (CollectionsGlobal.picker-anchor.right - self.width).clamp(8px, root.width - self.width - 8px);
                y: CollectionsGlobal.picker-anchor.bottom + self.height + 12px <= root.height
                    ? CollectionsGlobal.picker-anchor.bottom + 4px
                    : CollectionsGlobal.picker-anchor.top - self.height - 4px;
                picked(index) => {
                    CollectionsGlobal.add-to-collection(index, CollectionsGlobal.picker-anchor.track);
                    root.close-collection-picker();
                }
            }
        }

        update-popup-anchor := Rectangle {
            x: (root.width - 380px) / 2;
            y: (root.height - 240px) / 2;
            width: 1px;
            height: 1px;
            update-popup := PopupWindow {
                width: 380px;
                height: 240px;
                close-policy: close-on-click-outside;
                MessagePopup {
                    heading: @tr("LX source update");
                    message: root.update-message;
                    update-url: root.update-url;
                    open-update => {
                        root.open-url-in-browser(root.update-url);
                        update-popup.close();
                    }
                    dismissed => { update-popup.close(); }
                }
            }
        }

        operation-popup-anchor := Rectangle {
            x: (root.width - 380px) / 2;
            y: (root.height - 190px) / 2;
            width: 1px;
            height: 1px;
            operation-popup := PopupWindow {
                width: 380px;
                height: 190px;
                close-policy: close-on-click-outside;
                MessagePopup {
                    message: root.operation_error_message;
                    dismissed => { operation-popup.close(); }
                }
            }
        }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.maximized || root.now-playing-sliding ? 0px : 6px;
        border-width: root.maximized ? 0px : 1px;
        border-color: Theme.border;
        background: transparent;
    }
}
