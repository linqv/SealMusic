import { CollectionsGlobal, TrackActions } from "collections.slint";
import { OnlineGlobal } from "online.slint";
import { Theme } from "theme.slint";
import {
    Button,
    ListView,
    ScrollView,
} from "std-widgets.slint";
import { SongInfo, SortKey } from "types.slint";
import { IconDisplay, IconSet } from "@lucide";

component SortIcon inherits Rectangle {
    in-out property <bool> ascending: true;
    in-out property <bool> display: true;
    height: 15px;
    width: 15px;
    background: transparent;
    IconDisplay {
        visible: root.display;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: root.ascending ? IconSet.ArrowUp : IconSet.ArrowDown;
        size: min(parent.width, parent.height);
        stroke: Theme.text-tertiary;
        stroke-width: 1.8;
    }
}

component TitleBarItem inherits Rectangle {
    in property <string> name;
    in-out property <bool> display-sort-icon <=> arrow.display;
    in-out property <bool> ascending-sort <=> arrow.ascending;
    Rectangle {
        width: 100%;
        height: 100%;
        text := Text {
            text: name;
            color: Theme.text-tertiary;
            x: 12px;
            y: parent.height / 2 - self.height / 2;
        }

        arrow := SortIcon {
            ascending: true;
            width: 12px;
            height: 12px;
            x: text.x + text.width + 5px;
            y: parent.height / 2 - self.height / 2;
        }
    }
}

component SortColumn inherits Rectangle {
    in property <string> label;
    in property <SortKey> sort-key;
    in property <SortKey> current-key;
    in property <bool> ascending;
    callback clicked(SortKey, bool);
    height: 100%;

    touch-area := TouchArea {
        clicked => {
            root.clicked(root.sort-key, root.ascending);
        }
        TitleBarItem {
            width: 100%;
            height: 100%;
            name: root.label;
            background: touch-area.has-hover ? Theme.hover : transparent;
            display-sort-icon: root.current-key == root.sort-key;
            ascending-sort: root.ascending;
        }
    }
}

component SortBar inherits Rectangle {
    height: 40px;
    in-out property <SortKey> key;
    in-out property <bool> ascending;
    callback sort-items(SortKey, bool);
    background: Theme.surface;

    HorizontalLayout {
        x: 0px;
        width: parent.width - 96px;
        SortColumn {
            width: 40%;
            label: @tr("Title");
            sort-key: SortKey.BySongName;
            current-key: root.key;
            ascending: root.ascending;
            clicked(key, asc) => {
                root.sort-items(key, asc);
            }
        }

        SortColumn {
            width: 34%;
            label: @tr("Artist");
            sort-key: SortKey.BySinger;
            current-key: root.key;
            ascending: root.ascending;
            clicked(key, asc) => {
                root.sort-items(key, asc);
            }
        }

        SortColumn {
            label: @tr("Duration");
            sort-key: SortKey.ByDuration;
            current-key: root.key;
            ascending: root.ascending;
            clicked(key, asc) => {
                root.sort-items(key, asc);
            }
        }
    }
}

export component SongDetails inherits Rectangle {
    in property <SongInfo> info;
    in property <string> artist: root.info.singer;
    border-color: Theme.text;
    VerticalLayout {
        padding: 5px;
        Text {
            text: @tr("SongItem" => "Title: {}\nArtist: {}\nDuration: {}", root.info.song-name, root.artist, root.info.duration);
        }
    }
}

export component LocalSongMenu inherits ContextMenuArea {
    in property <string> track;
    in property <int> collection: -1;
    Menu {
        MenuItem {
            title: @tr("SongItem" => "Play using LX source");
            activated => {
                if root.collection >= 0 {
                    CollectionsGlobal.play-collection-track(root.collection, root.track, true);
                } else {
                    OnlineGlobal.play-local-source(root.track);
                }
            }
        }
    }
}

component SongItem inherits Rectangle {
    height: 30px;
    in property <SongInfo> info;
    in property <bool> playing: false;
    in property <int> collection: -1;
    callback double_clicked();
    background: root.playing ? Theme.hover : (area.has-hover ? Theme.song-hover : Theme.surface);

    area := TouchArea {
        x: 0px;
        width: parent.width - actions.width;
        height: 100%;
        double-clicked => { root.double_clicked(); }

        HorizontalLayout {
            Rectangle {
                width: 40%;
                Text {
                    x: 12px;
                    width: parent.width - 18px;
                    height: 100%;
                    text: root.info.song-name;
                    font-weight: root.playing ? 600 : 400;
                    color: root.playing ? Theme.accent : Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            Rectangle {
                width: 34%;
                Text {
                    x: 12px;
                    width: parent.width - 18px;
                    height: 100%;
                    text: root.info.singer;
                    color: root.playing ? Theme.accent : Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                Text {
                    x: 12px;
                    width: parent.width - 18px;
                    height: 100%;
                    text: root.info.duration;
                    color: root.playing ? Theme.accent : Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        Tooltip {
            SongDetails {
                info: root.info;
            }
        }
    }

    actions := TrackActions {
        x: parent.width - self.width;
        y: (parent.height - self.height) / 2;
        width: root.collection >= 0 ? 96px : 64px;
        height: 28px;
        collection: root.collection;
        track: root.info.id;
    }

    if root.info.is-local && OnlineGlobal.local-playback: LocalSongMenu {
        track: root.info.id;
        collection: root.collection;
    }
}

export component MessagePopup inherits Rectangle {
    in property <string> heading: @tr("Operation failed");
    in property <string> message;
    in property <string> update-url;
    callback open-update();
    callback dismissed();
    width: 100%;
    height: 100%;
    background: Theme.surface;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: 8px;

    VerticalLayout {
        width: 100%;
        height: 100%;
        padding: 20px;
        spacing: 12px;
        Text {
            text: root.heading;
            color: Theme.text;
            font-size: 18px;
            font-weight: 600;
        }

        message-scroll := ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            content-height: message-text.preferred-height;
            message-text := Text {
                x: 0px;
                y: 0px;
                width: message-scroll.visible-width;
                text: root.message;
                color: Theme.text-secondary;
                font-size: 13px;
                wrap: word-wrap;
            }
        }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            if root.update-url != "": Button {
                text: @tr("Open update link");
                clicked => { root.open-update(); }
            }
            Button {
                text: @tr("Close");
                clicked => { root.dismissed(); }
            }
        }
    }
}

export component SongListView inherits Rectangle {
    in-out property <bool> ascending;
    in-out property <SortKey> sort-key;
    in-out property <length> scroll-y;
    in property <SongInfo> current-song;
    callback sort-songs(SortKey, bool);
    callback browse();
    background: Theme.surface;
    VerticalLayout {
        width: 100%;
        height: 100%;
        if CollectionsGlobal.songs.length > 0: SortBar {
            ascending: root.ascending;
            key: root.sort-key;
            sort-items(key, ascending) => {
                if (root.sort-key == key) {
                    root.sort-songs(key, !ascending);
                } else {
                    root.sort-songs(key, true)
                }
            }
        }

        if CollectionsGlobal.songs.length == 0: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 12px;
            Text {
                text: CollectionsGlobal.selected == 0
                    ? @tr("Songs you like will appear here.")
                    : @tr("Add songs from search or another collection.");
                horizontal-alignment: center;
                color: Theme.text-secondary;
            }
            HorizontalLayout {
                alignment: center;
                Button {
                    text: @tr("Find songs");
                    clicked => { root.browse(); }
                }
            }
        }

        if CollectionsGlobal.songs.length > 0: ListView {
            vertical-stretch: 1;
            content-y <=> root.scroll-y;
            for item in CollectionsGlobal.songs: SongItem {
                collection: CollectionsGlobal.selected;
                info: item;
                playing: item.id == root.current-song.id;
                double_clicked => {
                    CollectionsGlobal.play-collection-track(CollectionsGlobal.selected, item.id, false);
                }
            }
        }
    }
}
