import { OnlineGlobal } from "online.slint";
import { Theme } from "theme.slint";
import {
    Button,
    ListView,
    ScrollView,
} from "std-widgets.slint";
import { SongInfo, SortKey } from "types.slint";
import { IconDisplay, IconSet } from "@lucide";

component SortIcon inherits Rectangle {
    in-out property <bool> ascending: true;
    in-out property <bool> display: true;
    height: 15px;
    width: 15px;
    background: transparent;
    IconDisplay {
        visible: root.display;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: root.ascending ? IconSet.ArrowUp : IconSet.ArrowDown;
        size: min(parent.width, parent.height);
        stroke: Theme.text-tertiary;
        stroke-width: 1.8;
    }
}

component TitleBarItem inherits Rectangle {
    in property <string> name:"name";
    in-out property <bool> display-sort-icon <=> arrow.display;
    in-out property <bool> ascending-sort <=> arrow.ascending;
    Rectangle {
        width: 100%;
        height: 100%;
        text := Text {
            text: name;
            color: Theme.text-tertiary;
            x: parent.width * 0.4;
            y: parent.height / 2 - self.height / 2;
        }

        arrow := SortIcon {
            ascending: true;
            width: 12px;
            height: 12px;
            x: text.x + text.width + 5px;
            y: parent.height / 2 - self.height / 2;
        }
    }
}

component SortColumn inherits Rectangle {
    in property <string> label;
    in property <SortKey> sort-key;
    in property <SortKey> current-key;
    in property <bool> ascending;
    callback clicked(SortKey, bool);
    height: 100%;
    width: 33%;

    touch-area := TouchArea {
        clicked => {
            root.clicked(root.sort-key, root.ascending);
        }
        TitleBarItem {
            width: 100%;
            height: 100%;
            name: root.label;
            background: touch-area.has-hover ? Theme.hover : transparent;
            display-sort-icon: root.current-key == root.sort-key;
            ascending-sort: root.ascending;
        }
    }
}

component SortBar inherits Rectangle {
    height: 30px;
    in-out property <SortKey> key;
    in-out property <bool> ascending;
    callback sort-items(SortKey, bool);
    background: Theme.surface;

    HorizontalLayout {
        alignment: space-between;
        SortColumn {
            label: @tr("Title");
            sort-key: SortKey.BySongName;
            current-key: root.key;
            ascending: root.ascending;
            clicked(key, asc) => {
                root.sort-items(key, asc);
            }
        }

        SortColumn {
            label: @tr("Artist");
            sort-key: SortKey.BySinger;
            current-key: root.key;
            ascending: root.ascending;
            clicked(key, asc) => {
                root.sort-items(key, asc);
            }
        }

        SortColumn {
            label: @tr("Duration");
            sort-key: SortKey.ByDuration;
            current-key: root.key;
            ascending: root.ascending;
            clicked(key, asc) => {
                root.sort-items(key, asc);
            }
        }
    }
}

export component SongItem inherits Rectangle {
    height: 30px;
    in property <SongInfo> info;
    in property <bool> playing:false;
    callback double_clicked();
    background: playing ? Theme.hover : (area.has-hover ? Theme.song-hover : Theme.surface);
    VerticalLayout {
        area := TouchArea {
            double-clicked => {
                double_clicked();
            }
            HorizontalLayout {
                alignment: space-between;
                Rectangle {
                    width: 33%;
                    Text {
                        width: 100%;
                        x: parent.width * 0.4;
                        text: info.song-name;
                        font-weight: root.playing ? 600 : 400;
                        color: root.playing ? Theme.accent : Theme.text;
                        overflow: elide;
                    }
                }

                Rectangle {
                    width: 33%;
                    Text {
                        width: 100%;
                        x: parent.width * 0.4;
                        text: info.singer;
                        color: root.playing ? Theme.accent : Theme.text;
                        overflow: elide;
                    }
                }

                Rectangle {
                    width: 33%;
                    Text {
                        x: parent.width * 0.4;
                        text: info.duration;
                        color: root.playing ? Theme.accent : Theme.text;
                    }
                }
            }

            Tooltip {
                Rectangle {
                    border-color: Theme.text;
                    VerticalLayout {
                        padding: 5px;
                        Text {
                            text: @tr("Title: {}\nArtist: {}\nDuration: {}", info.song-name, info.singer, info.duration);
                        }
                    }
                }
            }
        }
    }

    if OnlineGlobal.local-playback: ContextMenuArea {
        Menu {
            MenuItem {
                title: @tr("Play using LX source");
                activated => { OnlineGlobal.play-local-source(root.info.id); }
            }
        }
    }
}

export component MessagePopup inherits Rectangle {
    in property <string> heading: @tr("Operation failed");
    in property <string> message;
    in property <string> update-url;
    callback open-update();
    callback dismissed();
    width: 100%;
    height: 100%;
    background: Theme.surface;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: 8px;

    VerticalLayout {
        width: 100%;
        height: 100%;
        padding: 20px;
        spacing: 12px;
        Text {
            text: root.heading;
            color: Theme.text;
            font-size: 18px;
            font-weight: 600;
        }

        message-scroll := ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            content-height: message-text.preferred-height;
            message-text := Text {
                x: 0px;
                y: 0px;
                width: message-scroll.visible-width;
                text: root.message;
                color: Theme.text-secondary;
                font-size: 13px;
                wrap: word-wrap;
            }
        }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            if root.update-url != "": Button {
                text: @tr("Open update link");
                clicked => { root.open-update(); }
            }
            Button {
                text: @tr("Close");
                clicked => { root.dismissed(); }
            }
        }
    }
}

export component SongListView inherits Rectangle {
    in-out property <bool> ascending;
    in-out property <SortKey> sort-key;
    in-out property <SortKey> last-sort-key;
    in-out property <[SongInfo]> song-list;
    in-out property <length> scroll-y;
    in property <SongInfo> current-song;
    callback sort-songs(SortKey, bool);
    callback play-song(SongInfo);
    background: Theme.surface;
    VerticalLayout {
        width: 100%;
        height: 100%;
        SortBar {
            ascending: root.ascending;
            key: root.sort-key;
            sort-items(key, ascending) => {
                if (root.last-sort-key == key) {
                    root.sort-songs(key, !ascending);
                } else {
                    root.sort-songs(key, true)
                }
            }
        }

        ListView {
            content-y <=> root.scroll-y;
            for item in root.song-list: SongItem {
                info: item;
                playing: item.id == root.current-song.id;
                double_clicked => {
                    root.play-song(item);
                }
            }
        }
    }
}
